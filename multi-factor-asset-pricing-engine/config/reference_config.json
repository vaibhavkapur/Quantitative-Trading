{
  "config_version": "1.0.0",
  "run_label": "reference_hand_calculated",
  "asset_returns_path": "data/fixtures/reference_hand_calculated/asset_returns.csv",
  "factor_returns_path": "data/fixtures/reference_hand_calculated/factor_returns.csv",
  "risk_free_path": "data/fixtures/reference_hand_calculated/risk_free.csv",
  "memberships_path": "data/fixtures/reference_hand_calculated/portfolio_memberships.csv",
  "baseline_model_name": "CAPM",
  "frequency": "M",
  "annualization_factor": 12.0,
  "cov_type": "OLS",
  "hac_maxlags": 0,
  "fm_hac_maxlags": 0,
  "universe_policy": "strict_balanced",
  "rf_missing_policy": "error",
  "period_alignment_policy": "strict",
