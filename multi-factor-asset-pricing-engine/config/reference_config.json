  "seed": 42,
  "output_dir": "reports/reference_run",
  "models": [
    {
      "name": "CAPM",
      "factors": ["MKT_RF"],
      "include_ts_intercept": true,
      "include_cs_intercept": true,
      "description": "Reference CAPM model for exact hand-calculated verification."
    },
    {
      "name": "TWO_FACTOR",
      "factors": ["MKT_RF", "VAL"],
      "include_ts_intercept": true,
      "include_cs_intercept": true,
      "description": "Reference two-factor model with exact closed-form betas and premia."
    }
  ]
}
